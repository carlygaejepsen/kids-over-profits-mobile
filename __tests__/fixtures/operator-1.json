    "news": [
        {
            "id": 60,
            "title": "Why do kids keep going missing? Inside the troubled teen industry",
            "outlet": "CBC",
            "date": "2023-02-23",
            "date_label": "Feb 23, 2023",
            "url": "https://www.cbc.ca/player/play/audio/9.7100032",
            "type": "expose",
            "summary": "A 16-year-old boy named Daniel Yuen went missing after enrolling in a 'tough love' bootcamp in California. His family had been seeking help for his depression. The bootcamp, CEDU Running Springs, was supposed to provide support, but Daniel vanished. An investigation into the troubled teen industry has uncovered ties to a dangerous cult and raises questions about the treatment of teenagers in these facilities.",
            "image": null,
            "about": "company"
        },
        {
            "id": 762,
            "title": "Allegations of Abuse at U.S. Troubled‑Teen Boarding Schools Involving Canadian Teens",
            "outlet": "HuffPost Canada",
            "date": "2020-11-22",
            "date_label": "Nov 22, 2020",
            "url": "https://www.huffingtonpost.ca/entry/boarding-school-abuse-canadians_ca_5fb53599c5b6f00bd84c6ef7",
            "type": "expose",
            "summary": "The article reports allegations of physical restraint, solitary confinement, and sexual misconduct at several U.S. troubled‑teen boarding schools that housed Canadian teenagers. Survivors describe harsh punishments, forced medication, and isolation, and the facilities have faced legal and regulatory scrutiny. The piece highlights gaps in oversight and the impact on the survivors’ mental health.",
            "image": null,
            "about": "facility"
        }
